# API Keys
OPENAI_API_KEY=your_openai_api_key_here
JINA_API_KEY=your_jina_api_key_here

# Tesseract Configuration
TESSERACT_CMD=tesseract
# For Windows example:
# TESSERACT_CMD=D:\tesseract\tesseract.exe

# OCR Settings
OCR_LANGUAGES=chi_sim+eng

# PDF Processing
PDF_DPI=220
MAX_CHARTS_PER_PAGE=8

# Chart Detection
CHART_MIN_AR=0.25
CHART_MAX_AR=4.0
CHART_MIN_WIDTH=150
CHART_MIN_HEIGHT=150
CHART_MIN_ABSOLUTE_AREA=30000
CHART_MIN_REL_AREA=0.005
CHART_MIN_EDGE_DENSITY=0.002
CHART_MIN_QUALITY_THRESHOLD=0.4

# Jina API Settings
JINA_API_URL=https://api.jina.ai/v1/embeddings
JINA_MODEL_NAME=jina-embeddings-v4

# OpenAI API Settings
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini

# Retrieval Settings
EMBEDDING_DIM=2048
MAX_RESULTS=3
EF_CONSTRUCTION=200
EF=50
RETRIEVAL_ALPHA=0.6

# Processing Options
USE_MULTIPROCESSING=false
MAX_WORKERS=0

# Application Settings
LOG_LEVEL=INFO
CACHE_DIR=./cache
UPLOAD_DIR=./uploads
PROCESSED_DIR=./processed
PREPROCESS_DIR=./preprocessed
PREPROCESS_CACHE_DIR=./preprocessed_cache
